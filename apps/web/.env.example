LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
OPENROUTER_API_KEY=sk-or-v1-...
# Experimental: when set, Playground routes through Vercel AI SDK + AI Gateway
# instead of OpenRouter (takes priority if both keys are present).
AI_GATEWAY_API_KEY=

# Auth.js (next-auth v5). AUTH_SECRET is mandatory in production.
# Generate one with: bunx auth secret
AUTH_SECRET=
# Google OAuth — Google Cloud Console → OAuth 2.0 Client IDs.
# Authorized redirect URI: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Allowlist (optional). If both are empty, sign-in is open.
# If either is set, an account is allowed when its email matches AUTH_ALLOWED_EMAILS
# OR its email's domain matches AUTH_ALLOWED_EMAIL_DOMAINS.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_EMAIL_DOMAINS=
