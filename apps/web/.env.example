LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
OPENROUTER_API_KEY=sk-or-v1-...
# Experimental: when set, Playground routes through Vercel AI SDK + AI Gateway
# instead of OpenRouter (takes priority if both keys are present).
AI_GATEWAY_API_KEY=

# Auth.js (next-auth v5) — OPTIONAL. Leave all three blank to run the app open
# (anyone with the URL can use it — see README "Authentication" for the
# security trade-offs). To enable Google sign-in, set ALL THREE of these.
# Generate AUTH_SECRET with: bunx auth secret
AUTH_SECRET=
# Google OAuth — Google Cloud Console → OAuth 2.0 Client IDs.
# Authorized redirect URI: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Allowlist (only relevant when auth is enabled). If both are empty, any Google
# account can sign in. If either is set, an account is allowed when its email
# matches AUTH_ALLOWED_EMAILS OR its email's domain matches AUTH_ALLOWED_EMAIL_DOMAINS.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_EMAIL_DOMAINS=
