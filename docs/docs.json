{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PromptFlow",
  "colors": {
    "primary": "#09090b",
    "light": "#71717a",
    "dark": "#09090b"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "anchors": [
      {
        "anchor": "Changelog",
        "icon": "list",
        "pages": [
          "changelog/overview"
        ]
      },
      {
