              "web/authentication"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/commands"
            ]
          },
          {
            "group": "MCP Server",
            "pages": [
              "mcp-server/overview",
              "mcp-server/setup",
              "mcp-server/tools"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
