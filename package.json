{
  "name": "promptflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docs": "turbo run dev --filter=docs",
    "docs:build": "turbo run build --filter=docs",
    "screenshot": "bun scripts/screenshot.ts",
    "screenshot:setup": "bun scripts/screenshot-setup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "playwright": "^1.50.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.11"
}
