# Langfuse — get keys from your Langfuse project settings
# https://cloud.langfuse.com (or your self-hosted Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# PostHog (alternative to Langfuse) — https://posthog.com/docs/prompt-management
# Personal API key with llm_prompt:read/write scope; PROJECT_ID from your
# PostHog project settings; HOST is region-specific (US/EU) or self-hosted.
POSTHOG_PERSONAL_API_KEY=phx_...
POSTHOG_PROJECT_ID=...
POSTHOG_HOST=https://us.posthog.com

# Configure either (or both, then pick the active one in Settings).

# OpenRouter — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
